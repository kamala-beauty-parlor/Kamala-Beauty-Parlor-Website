rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kamalaparlor@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // users/{uid}
    // A user can read and create/update ONLY their own document (request.auth.uid == uid), and cannot change role; admin can read all users
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && (request.resource.data.role == 'user' || request.resource.data.role == 'customer' || isAdmin());
      allow update: if isValidId(userId) && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // bookings/{bookingId}
    // - a signed-in user can CREATE a booking only with userId == request.auth.uid and status == "pending"
    // - a user can READ only bookings where userId == request.auth.uid
    // - a user can only update their own booking to status "cancelled"
    // - admin can read, update and delete all bookings
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(bookingId) && isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isValidId(bookingId) && (
        isAdmin() ||
        (isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'cancelled' &&
          (resource.data.status == 'pending' || resource.data.status == 'confirmed'))
      );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // serviceCategories/{categoryId} (public read, admin write)
    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // services/{serviceId} (public read, admin write)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // courses/{courseId} (public read, admin write)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // gallery/{photoId} (public read, admin write)
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // sections/{sectionId} (public read, admin write)
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // testimonials/{testimonialId} (public read, admin write, customer create)
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidId(testimonialId) && isSignedIn();
      allow update, delete: if isAdmin();
    }

    // messages/{messageId} (anyone can create, only admin can read, update, delete)
    match /messages/{messageId} {
      allow create: if isValidId(messageId) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // settings/{settingId} (public read, admin write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

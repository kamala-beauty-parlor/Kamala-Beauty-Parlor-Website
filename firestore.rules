rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kamalaparlor@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // users/{userId}
    // Allow reading and writing user profiles so new accounts are persisted in Firestore and visible to Admin
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // bookings/{bookingId}
    // Allow clients to book appointments and admin to manage all bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId);
      allow update: if isValidId(bookingId);
      allow delete: if isValidId(bookingId);
    }

    // serviceCategories/{categoryId} (public read, admin write)
    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // services/{serviceId} (public read, admin write)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // courses/{courseId} (public read, admin write)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // gallery/{photoId} (public read, admin write)
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // sections/{sectionId} (public read, admin write)
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // testimonials/{testimonialId} (public read, admin write, customer create)
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidId(testimonialId) && isSignedIn();
      allow update, delete: if isAdmin();
    }

    // messages/{messageId} (anyone can create, only admin can read, update, delete)
    match /messages/{messageId} {
      allow create: if isValidId(messageId) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // settings/{settingId} (public read, admin write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

